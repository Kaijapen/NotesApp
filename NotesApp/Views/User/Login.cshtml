@model LoginUser
<div>
    <h1 class="display-4">Login</h1>
    <span asp-validation-for="LoginEmail" class="text-danger"></span>
    <span asp-validation-for="LoginPassword" class="text-danger"></span>

    <form asp-action="LoginUser" asp-controller="User" method="post">
        <div class="form-group">
            <label >Email</label>
            <input asp-for="LoginEmail" class="form-control" />
        </div>
        <div class="form-group">
            <label >Password</label>
            <input asp-for="LoginPassword" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Login</button>
    </form>
    <p>Don't have an account? <a asp-action="Index" asp-controller="User">Register here</a>.</p>
</div>
